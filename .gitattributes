# Source documents intake. NOTE: knowledge/raw/ is gitignored by default - git-LFS versioning of
# raw sources is left here, armed, for whenever you decide to version your own library. Their
# plain-text transcripts stay in git.
**/*.pdf filter=lfs diff=lfs merge=lfs -text
**/*.epub filter=lfs diff=lfs merge=lfs -text
**/*.docx filter=lfs diff=lfs merge=lfs -text
**/*.pptx filter=lfs diff=lfs merge=lfs -text
**/*.xlsx filter=lfs diff=lfs merge=lfs -text

# Heavy media -> excluded from git; back these up with whatever tool you already use.
# (See .gitignore for *.mp4, *.mov, *.mp3, *.wav, etc.)
