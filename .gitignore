# Secrets & environment
.env
.env.*
*.key
*.pem
*.p12
credentials.json
secrets.json
secrets.yaml
secrets.yml
credentials.yaml
credentials.yml
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
.netrc
.npmrc
.pypirc
auth.json
token.txt
*.local.toml
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
venv/

# Runtime state, logs, databases - regenerated by running the system, never shipped
system/state/**
!system/state/.gitkeep
system/logs/**
!system/logs/.gitkeep
*.db
*.jsonl

# Your library - yours, not part of this repo's history (see knowledge/README.md)
knowledge/raw/*
!knowledge/raw/.gitkeep
knowledge/distilled/*
!knowledge/distilled/.gitkeep

# Local project workspaces - tracked examples belong elsewhere; working projects stay local.
projects/*
!projects/README.md

# Golden calibration set - contains verbatim excerpts from copyrighted books (see system/golden/README.md)
system/golden/*
!system/golden/.gitkeep
!system/golden/README.md

# Field reports (make signaler) - free-form prose from a project's own context, never versioned
docs/signalements/*
!docs/signalements/README.md

# Parentheses (make parenthese-ouvrir) - same reasoning as field reports
docs/parentheses/*
!docs/parentheses/README.md

# Downloaded models / weights - large, re-fetchable, not source
models/
*.gguf
*.safetensors
*.onnx

# Vector / keyword / graph stores - derived indexes, rebuilt from source documents
**/.vectorstore/
**/.keywordstore/
**/.graphstore/
**/.snapshotstore/

# Node (UI)
node_modules/
dist/
.journal/

# Large media - keep outside normal Git history; use an external backup or Git LFS deliberately.
*.mp4
*.mov
*.m4v
*.mp3
*.wav
*.m4a
*.flac

# OS / editor
.DS_Store
.obsidian/
.vscode/
.idea/
*.swp
